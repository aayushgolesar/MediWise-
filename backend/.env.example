# MongoDB Atlas database connection. Keep this server-side and never commit backend/.env.
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?appName=Cluster0"
MONGODB_DB_NAME="mediwise"
JWT_SECRET="REPLACE_WITH_A_RANDOM_32_CHARACTER_MINIMUM_SECRET"
APP_URL="http://localhost:3000"
PORT="4000"
REDIS_URL="redis://127.0.0.1:6379"

# On Windows development machines, start scripts use Node's system certificate store
# to validate MongoDB Atlas TLS certificates.
