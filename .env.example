# GEMINI_API_KEY: Required for Gemini AI API calls.
# Keep this server-side; never use a VITE_ prefix for it.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
JWT_SECRET="REPLACE_WITH_A_RANDOM_32_CHARACTER_MINIMUM_SECRET"

# App and API development configuration.
APP_URL="http://localhost:3000"
PORT="4000"
API_URL="http://localhost:4000"
DB_PATH="./mediwise.db"
